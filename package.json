{
  "name": "gmail-imap",
  "version": "1.1.0",
  "description": "Claude plugin: Gmail (and any IMAP/SMTP mailbox) via App Passwords. Server-side IMAP search with Gmail X-GM-RAW, thread fetch, HTML→text fallback, send/reply with confirmation guardrail, and attachment download to disk.",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --target=node18 --format=cjs --outfile=dist/index.cjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "claude",
    "claude-code",
    "cowork",
    "plugin",
    "mcp",
    "gmail",
    "email",
    "imap",
    "smtp"
  ],
  "license": "MIT",
  "author": "Manuel Fedele <manuelfedele@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/manuelfedele/gmail-imap.git"
  },
  "homepage": "https://github.com/manuelfedele/gmail-imap#readme",
  "bugs": {
    "url": "https://github.com/manuelfedele/gmail-imap/issues"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "imapflow": "^1.0.180",
    "mailparser": "^3.7.1",
    "nodemailer": "^6.9.16",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/mailparser": "^3.4.4",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^6.4.16",
    "esbuild": "^0.25.0",
    "typescript": "^5.6.0"
  }
}
